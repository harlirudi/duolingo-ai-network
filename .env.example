# Supabase — pilih salah satu:
# A) Local: jalankan `supabase start` (butuh Docker)
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=eyJhbGciOi...

# B) Cloud: bikin project gratis di https://supabase.com
#    Settings → Data API → copy URL + publishable key
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable__...

# Expo
# EXPO_PUBLIC_SUPABASE_URL=<copy dari atas>
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<copy dari atas>

# OpenAI — untuk AI tools
# Dapatkan di https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
