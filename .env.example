# Supabase — pilih salah satu:
# A) Local: jalankan `supabase start` (butuh Docker)
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=eyJhbGciOi...

# B) Cloud: bikin project gratis di https://supabase.com
#    Settings → Data API → copy URL + publishable key
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable__...

# Expo — copy URL + publishable key dari Supabase dashboard
# EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__...

# OpenAI — HANYA server-side (Edge Functions), JANGAN di client .env
# Set via: supabase secrets set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
